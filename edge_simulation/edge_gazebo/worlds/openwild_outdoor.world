    <!-- Construction barrel 2 -->
    <include>
      <uri>model://props/construction_barrel</uri>
      <name>construction_barrel2</name>
      <pose relative_to='world_offset'>-8.04248 -6.232954 0 0 0 1.57</pose>
    </include>

    <!-- Cylinder Large -->
    <include>
      <uri>model://props/falling_rock3</uri>
      <name>cylinder_large</name>
      <pose relative_to='world_offset'>0 -1.5 0.5 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Cuboid Medium -->
    <include>
      <uri>model://props/falling_rock3</uri>
      <name>cuboid_medium</name>
