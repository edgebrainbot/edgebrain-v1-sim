<?xml version="1.0"?>
<sdf version="1.8">
  <world name="simple_indoor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="ignition-gazebo-apply-link-wrench-system"
      name="gz::sim::systems::ApplyLinkWrench">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://shaped/cubic_medium</uri>
      <name>cubic_medium</name>
      <pose>6.86722 -3.00334 0.5 0 -0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cuboid_medium</uri>
      <name>cuboid_medium</name>
      <pose>2.93083 3.17413 0.5 0 -0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cuboid_small</uri>
      <pose>2.77777 -0.965179 0.5 0 -0 0</pose>
      <name>cuboid_small</name>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cubic_large</uri>
      <pose>6.83432 2.93655 0.5 0 -0 0</pose>
      <name>cubic_large</name>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cylinder_medium</uri>
      <pose>2.06176 -3.02362 0.5 0 -0 0</pose>
      <name>cylinder_medium</name>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cylinder_small</uri>
      <pose>6.93418 -1.01849 0.5 0 -0 0</pose>
      <name>cylinder_small</name>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cylinder_large</uri>
      <pose>2.96968 0.886818 0.5 0 -0 0</pose>
      <name>cylinder_large</name>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/cuboid_thin</uri>
      <pose>4.434793 -3.83522 0.5 0 -0 0</pose>
      <name>cuboid_thin</name>
      <static>true</static>
    </include>

    <include>
      <uri>model://shaped/enclosure</uri>
      <static>true</static>
    </include>

  </world>
</sdf>