<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== LiDAR Macro ========== -->
  <xacro:macro name="lidar_macro" params="parent lidar_name xyz rpy:='0 0 0' mass:=1.0">

    <!-- LiDAR Link -->
    <link name="${lidar_name}_link">
      <visual>
        <origin xyz="0 ${-0.015 * vehicle_scale} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find warrior_description)/meshes/unitree_lidar.stl" scale="${vehicle_scale} ${vehicle_scale} ${vehicle_scale}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 ${-0.015 * vehicle_scale} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find warrior_description)/meshes/unitree_lidar.stl" scale="${vehicle_scale} ${vehicle_scale} ${vehicle_scale}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 ${-0.015 * vehicle_scale} 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${0.01 * vehicle_scale**2}" ixy="${0 * vehicle_scale**2}" ixz="${0 * vehicle_scale**2}" iyy="${0.01 * vehicle_scale**2}" iyz="${0 * vehicle_scale**2}" izz="${0.005 * vehicle_scale**2}"/>
      </inertial>
    </link>

    <!-- LiDAR Joint -->
    <joint name="${lidar_name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${lidar_name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Gazebo Sensor Plugin -->
    <gazebo reference="${lidar_name}_link">

      <sensor name="${lidar_name}" type="gpu_lidar">
        <topic>${lidar_name}/scan</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>${lidar_name}_link</gz_frame_id>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
            <vertical>
              <samples>30</samples>
              <resolution>1</resolution>
              <min_angle>0.10</min_angle>
              <max_angle>1.2</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.05</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>

        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
