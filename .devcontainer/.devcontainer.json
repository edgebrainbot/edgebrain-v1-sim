{
  "name": "Edge Brain Dev",
  // "build": {
  //   "dockerfile": "Dockerfile",
  //   "context": ".."
  // },
  "runArgs": [
    "--network=host",
    "--runtime=nvidia",
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
    "--privileged"
  ],
  "workspaceFolder": "/home/edgebot/ros2_ws",
  "remoteUser": "edgebot",
  "mounts": [
    "source=${localWorkspaceFolder}/models,target=/home/edgebot/models,type=bind"
  ],
  "postCreateCommand": "bash /home/edgebot/ros_entrypoint.sh",
  "extensions": [
    "ms-iot.vscode-ros",
    "ms-python.python",
    "ms-vscode.cpptools",
    "ms-azuretools.vscode-docker",
    "njpwerner.autodocstring"
  ],
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash",
    "python.defaultInterpreterPath": "/usr/bin/python3"
  }
}
