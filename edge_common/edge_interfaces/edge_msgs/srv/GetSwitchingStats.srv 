# Request: Get detailed switching statistics
# Empty request - just query current stats
---
# Response: Detailed switching statistics

# Switching reason breakdown
string[] reasons                    # List of unique switching reasons
uint32[] counts                     # Corresponding violation counts for each reason

# Overall statistics
uint32 total_switches               # Total number of mode switches
uint32 student_duration_ms          # Total time spent in student mode (ms)
uint32 teacher_duration_ms          # Total time spent in teacher mode (ms)

# Current state
bool is_student_mode                # Current mode (true=student, false=teacher)
string last_switch_reason           # Reason for the most recent switch
uint64 last_switch_timestamp_ns     # Timestamp of last switch (nanoseconds)

# Performance metrics
float32 student_percentage          # Percentage of time in student mode (0-100)
float32 average_student_duration_ms # Average duration per student session
float32 average_teacher_duration_ms # Average duration per teacher session
uint32 switches_per_minute          # Switching frequency
