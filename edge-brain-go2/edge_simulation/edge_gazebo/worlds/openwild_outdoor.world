<?xml version="1.0"?>
<sdf version='1.8'>
  <world name='openwild_outdoor'>
    
    <frame name='world_offset'>
      <pose relative_to='world'>16 0 0 0 0 0</pose>
    </frame>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin
      filename="ignition-gazebo-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="ignition-gazebo-apply-link-wrench-system"
      name="gz::sim::systems::ApplyLinkWrench">
    </plugin>

    <plugin
      filename="ignition-gazebo6-navsat-system"
      name="ignition::gazebo::systems::NavSat">
    </plugin>
    <!-- Set the coordinates for the world origin -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.478950</latitude_deg>
      <longitude_deg>19.057785</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin> -->

    <!-- Main directional light - neutral lunar sunlight -->
    <light name='sun' type='directional'>
      <!-- Avoid legacy Ogre sensor shadow rendering during startup. -->
      <cast_shadows>false</cast_shadows>
      <pose relative_to='world_offset'>5 5 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Soft point light for ambient effect -->
    <light name='point_light_1' type='point'>
      <pose relative_to='world_offset'>0 0 5 0 0 0</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Gray-white lunar surface - matching visual and collision meshes -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://props/lunar_ground/meshes/terrain.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://props/lunar_ground/meshes/ground.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <visual name="hill_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://props/lunar_ground/meshes/hill.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>


